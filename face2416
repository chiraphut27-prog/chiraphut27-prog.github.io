
<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Face Blendshape - Chiraphut27</title>

  <script type="importmap">
  {
    "imports": {
      "three": "https://unpkg.com/three@0.160.0/build/three.module.js",
      "three/addons/": "https://unpkg.com/three@0.160.0/examples/jsm/",
      "mindar-face-three": "https://cdn.jsdelivr.net/npm/mind-ar@1.2.5/dist/mindar-face-three.prod.js"
    }
  }
  </script>

  <style>
    * { box-sizing: border-box; }

    body {
      margin: 0;
      overflow: hidden;
      background: #111;
      color: white;
      font-family: Arial, sans-serif;
    }

    #container {
      width: 100vw;
      height: 100vh;
      overflow: hidden;
    }

    #status {
      position: absolute;
      top: 15px;
      left: 15px;
      right: 15px;
      z-index: 10;
      padding: 12px;
      background: #222d;
      border-radius: 10px;
      text-align: center;
    }
  </style>
</head>

<body>
  <div id="container"></div>
  <div id="status">กำลังโหลดระบบ...</div>

  <script type="module">
    import * as THREE from 'three';
    import { GLTFLoader } from 'three/addons/loaders/GLTFLoader.js';
    import { MindARThree } from 'mindar-face-three';

    const container = document.querySelector('#container');
    const status = document.querySelector('#status');

    async function main() {
      const mindar = new MindARThree({ container });
      const { renderer, scene, camera } = mindar;

      scene.add(
        new THREE.HemisphereLight(0xffffff, 0x777799, 2)
      );

      const light = new THREE.DirectionalLight(0xffffff, 1.5);
      light.position.set(0, 1, 3);
      scene.add(light);

      status.textContent = 'กำลังโหลด face416.glb...';

      // ไฟล์ face416.glb ต้องอยู่ใน Repository เดียวกับ HTML
      const modelURL = './face416.glb';

      const loader = new GLTFLoader();
      const gltf = await loader.loadAsync(modelURL);
      const model = gltf.scene;

      model.scale.setScalar(2);

      const anchor = mindar.addAnchor(1);
      anchor.group.add(model);

      const meshes = [];

      model.traverse(object => {
        if (
          object.isMesh &&
          object.morphTargetDictionary &&
          object.morphTargetInfluences
        ) {
          meshes.push(object);
        }
      });

      console.log('Morph Target Meshes:', meshes.length);

      meshes.forEach(mesh => {
        console.log(mesh.name, mesh.morphTargetDictionary);
      });

      status.textContent = 'กำลังเปิดกล้อง...';
      await mindar.start();

      status.textContent = meshes.length
        ? 'โหลดโมเดลสำเร็จ'
        : 'โหลดโมเดลแล้ว แต่ไม่พบ Morph Targets';

      renderer.setAnimationLoop(() => {
        const categories =
          mindar.getLatestEstimate()?.blendshapes?.categories ?? [];

        for (const mesh of meshes) {
          for (const item of categories) {
            const index =
              mesh.morphTargetDictionary[item.categoryName];

            if (index !== undefined) {
              mesh.morphTargetInfluences[index] = item.score;
            }
          }
        }

        renderer.render(scene, camera);
      });
    }

    main().catch(error => {
      console.error(error);
      status.textContent =
        'เกิดข้อผิดพลาด: ตรวจสอบไฟล์ face416.glb และสิทธิ์กล้อง';
    });
  </script>
</body>
</html>
